# RoomTrace Environment Configuration

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roomtrace?schema=public"

# Redis & Job Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_ACCESS_SECRET=roomtrace_super_secure_access_secret_key_32_bytes_min!
JWT_REFRESH_SECRET=roomtrace_super_secure_refresh_secret_key_32_bytes_min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PASSWORD_SALT_ROUNDS=12

# Object Storage (S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=roomtrace-scans
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Movement Engine Tolerances (in Meters)
MOVEMENT_NOISE_THRESHOLD_METERS=0.02
MOVEMENT_MINOR_THRESHOLD_METERS=0.10
MOVEMENT_ROTATION_THRESHOLD_DEGREES=15.0
MOVEMENT_MIN_TRACKING_CONFIDENCE=0.60
MOVEMENT_MAX_REGISTRATION_RMSE=0.08

# Computer Vision & Inference
CV_DETECTOR_PROVIDER=simulator
CV_MODEL_PATH=./models/yolov8n.onnx
CV_CONFIDENCE_THRESHOLD=0.50
CV_IOU_THRESHOLD=0.45

# Observability
LOG_LEVEL=info
ENABLE_TELEMETRY=false
